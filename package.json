{
  "name": "fennec-cdp",
  "version": "2.0.0",
  "description": "Fennec (Firefox for Android) RDP + Keeper CDP adapter — Bun/Effect rewrite",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "fennec": "bin/fennec.ts"
  },
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "replay": "bun src/replay.ts",
    "test": "bun test",
    "test:live": "bun test test/*.live.ts",
    "typecheck": "bun x tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform": "^0.97.0",
    "@effect/platform-node": "^0.97.0",
    "@effect/schema": "^0.75.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chalk": "^5.3.0",
    "chrome-remote-interface": "^0.33.0",
    "commander": "^12.1.0",
    "effect": "^4.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.31.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "bun-types": "^1.2.0",
    "typescript": "^5.6.0"
  }
}